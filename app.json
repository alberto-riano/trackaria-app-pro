{
  "expo": {
    "name": "Trackaria Pro",
    "slug": "trackaria-pro",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trackariapro",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.trackaria.pro",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es"
        ]
      }
    },
    "android": {
      "package": "com.trackaria.pro",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#08766c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08766c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Trackaria Pro guarda tu sesión en el llavero del móvil para que no tengas que entrar cada vez."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a7da5c2-ed2a-40c1-9163-9e6396af668f"
      }
    },
    "owner": "trackaria",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/images/icon.png",
    "updates": {
      "url": "https://u.expo.dev/1a7da5c2-ed2a-40c1-9163-9e6396af668f"
    }
  }
}
